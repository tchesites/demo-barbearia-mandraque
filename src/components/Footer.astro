---
import { negocio, whatsappLink } from '../data/negocio.js';

const ano = new Date().getFullYear();
---

<footer class="site-footer texture">
  <div class="container footer__grid">
    <div class="footer__marca">
      <p class="footer__nome">Mombaque</p>
      <p class="footer__frase">
        Barba, cabelo e bigode na Lomba da Palmeira, em Sapucaia do Sul, desde
        2017.
      </p>
      <a
        class="link-simples"
        href={negocio.instagramUrl}
        target="_blank"
        rel="noopener"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
        </svg>
        {negocio.instagram}
      </a>
    </div>

    <div class="footer__col">
      <h2 class="footer__titulo">Onde ficamos</h2>
      <address class="footer__endereco">
        {negocio.endereco.rua}<br />
        {negocio.endereco.bairro} · {negocio.endereco.cidade}/{negocio.endereco.uf}<br />
        CEP {negocio.endereco.cep}
      </address>
      <a
        class="link-simples"
        href={negocio.googleMapsUrl}
        target="_blank"
        rel="noopener"
      >
        Abrir no Google Maps
      </a>
    </div>

    <div class="footer__col">
      <h2 class="footer__titulo">Falar com a gente</h2>
      <ul class="footer__links">
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener">
            WhatsApp · {negocio.telefoneDisplay}
          </a>
        </li>
        <li>
          <a href={negocio.linktreeUrl} target="_blank" rel="noopener">
            Linktree da barbearia
          </a>
        </li>
        <li>
          <a href="#servicos">Serviços e valores</a>
        </li>
        <li>
          <a href="#onde">Horários de atendimento</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer__base">
    <p>© {ano} Barbearia Mombaque</p>
    <p class="footer__demo">
      Site demonstrativo feito pela
      <a href="https://tchesites.com.br" target="_blank" rel="noopener">Tchê Sites</a>.
      Não é o site oficial da barbearia; valores e textos são ilustrativos.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--borda);
    background-color: var(--cacau-900);
    color: var(--texto-suave);
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .footer__nome {
    color: var(--creme);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .footer__frase {
    max-width: 34ch;
    margin-block: 1rem 1.5rem;
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .footer__titulo {
    margin-bottom: 1rem;
    color: var(--creme);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
  }

  .footer__endereco {
    margin-bottom: 1.25rem;
    font-size: var(--text-sm);
    font-style: normal;
    line-height: 1.8;
  }

  .footer__links {
    display: grid;
    gap: 0.65rem;
    font-size: var(--text-sm);
  }

  .footer__links a {
    transition: color var(--transition);
  }

  .footer__links a:hover {
    color: var(--creme);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--borda);
    font-size: var(--text-xs);
  }

  .footer__demo {
    max-width: 60ch;
    text-align: right;
  }

  .footer__demo a {
    border-bottom: 1px solid var(--borda-forte);
    color: var(--creme);
  }

  @media (max-width: 56rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__marca {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 36rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__demo {
      text-align: left;
    }
  }
</style>
