---
import { whatsappLink } from '../data/negocio.js';
import { url } from '../utils/url.js';
---

<header class="site-header">
  <div class="container header__inner">
    <a class="marca" href={url('/')}>
      <svg
        class="marca__selo"
        viewBox="0 0 40 40"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle cx="20" cy="20" r="19" fill="currentColor" />
        <circle cx="20" cy="20" r="15.5" fill="none" stroke="var(--cacau)" stroke-width="1.2" />
        <g transform="translate(20 20)">
          <rect x="-5" y="-11" width="10" height="22" rx="5" fill="var(--cacau)" />
          <clipPath id="pole-header">
            <rect x="-5" y="-11" width="10" height="22" rx="5" />
          </clipPath>
          <g clip-path="url(#pole-header)" stroke="currentColor" stroke-width="3">
            <path d="M-9 -14 L9 4" />
            <path d="M-9 -4 L9 14" />
            <path d="M-9 6 L5 20" />
          </g>
          <rect x="-7.5" y="-13" width="15" height="4" rx="1.5" fill="var(--cacau)" />
          <rect x="-7.5" y="9" width="15" height="4" rx="1.5" fill="var(--cacau)" />
        </g>
      </svg>
      <span class="marca__texto">
        <span class="marca__nome">Mandraque</span>
        <span class="marca__sub">barbearia · desde 2015</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      <a href="#servicos">Serviços</a>
      <a href="#espaco">Espaço</a>
      <a href="#historia">História</a>
      <a href="#curso">Curso e produtos</a>
      <a href="#onde">Onde fica</a>
    </nav>

    <a
      class="btn header__cta"
      href={whatsappLink()}
      target="_blank"
      rel="noopener"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M20.52 3.48A11.8 11.8 0 0 0 12.05 0C5.5 0 .2 5.3.2 11.85c0 2.09.55 4.13 1.6 5.93L0 24l6.38-1.67a11.8 11.8 0 0 0 5.67 1.44h.01c6.55 0 11.85-5.3 11.85-11.85 0-3.17-1.23-6.15-3.39-8.44ZM12.06 21.8a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.79.99 1.01-3.7-.23-.38a9.8 9.8 0 0 1-1.5-5.23c0-5.43 4.42-9.85 9.87-9.85 2.63 0 5.1 1.03 6.96 2.89a9.78 9.78 0 0 1 2.88 6.96c0 5.44-4.43 9.86-9.84 9.9Zm5.4-7.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.34 5.1 4.68.71.31 1.27.49 1.7.63.72.23 1.37.2 1.89.12.58-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.19-.57-.34Z"
        />
      </svg>
      Agendar
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--borda);
    background: rgba(43, 24, 16, 0.9);
    backdrop-filter: blur(14px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.6rem;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex: 0 0 auto;
  }

  .marca__selo {
    width: 2.2rem;
    height: auto;
    color: var(--creme);
    transition: transform var(--transition);
  }

  .marca:hover .marca__selo {
    transform: translateY(-1px) rotate(-4deg);
  }

  .marca__texto {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .marca__nome {
    color: var(--creme);
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .marca__sub {
    margin-top: 0.28rem;
    color: var(--texto-suave);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.75rem);
    margin-left: auto;
    font-size: var(--text-sm);
  }

  .nav a {
    position: relative;
    padding-block: 0.3rem;
    color: var(--texto-suave);
    font-weight: 500;
    transition: color var(--transition);
  }

  .nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--creme);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .nav a:hover {
    color: var(--creme);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  .header__cta {
    flex: 0 0 auto;
    min-height: 2.65rem;
    padding: 0.55rem 1.05rem;
    box-shadow: inset 0 0 0 2px var(--creme), inset 0 0 0 3px rgba(43, 24, 16, 0.32);
  }

  @media (max-width: 64rem) {
    .nav {
      display: none;
    }

    .header__cta {
      margin-left: auto;
    }
  }

  @media (max-width: 30rem) {
    .marca__sub {
      display: none;
    }

    .header__cta {
      font-size: 0.82rem;
    }
  }
</style>
