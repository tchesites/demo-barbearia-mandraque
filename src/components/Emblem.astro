---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['emblem', className]}
  viewBox="0 0 420 420"
  role="img"
  aria-label="Selo da Barbearia Mandraque: círculo creme com poste de barbeiro e a inscrição desde 2015"
  xmlns="http://www.w3.org/2000/svg"
>
  <circle cx="210" cy="210" r="200" fill="var(--creme, #f4e2b8)" />
  <circle cx="210" cy="210" r="186" fill="none" stroke="var(--cacau-700, #3a2317)" stroke-width="2.5" />
  <circle cx="210" cy="210" r="177" fill="none" stroke="var(--cacau-700, #3a2317)" stroke-width="0.8" opacity="0.45" />

  <path id="arco-mandraque" d="M 88 140 Q 210 32 332 140" fill="none" />
  <text
    fill="var(--cacau-700, #3a2317)"
    font-family="'Archivo', 'Segoe UI', sans-serif"
    font-size="21"
    font-weight="600"
    letter-spacing="7"
  >
    <textPath href="#arco-mandraque" startOffset="50%" text-anchor="middle">BARBEARIA</textPath>
  </text>

  <g transform="translate(210 186)">
    <rect x="-30" y="-53" width="60" height="106" rx="27" fill="var(--cacau-700, #3a2317)" />
    <clipPath id="pole-emblem">
      <rect x="-30" y="-53" width="60" height="106" rx="27" />
    </clipPath>
    <g clip-path="url(#pole-emblem)" stroke="var(--creme, #f4e2b8)" stroke-width="10">
      <path d="M-48 -88 L34 8" />
      <path d="M-48 -53 L46 41" />
      <path d="M-48 -18 L46 76" />
      <path d="M-48 17 L46 111" />
      <path d="M-48 52 L20 120" />
    </g>
    <rect x="-38" y="-66" width="76" height="14" rx="5" fill="var(--cacau-700, #3a2317)" />
    <rect x="-38" y="52" width="76" height="14" rx="5" fill="var(--cacau-700, #3a2317)" />
    <circle cx="0" cy="-72" r="5.5" fill="var(--cacau-700, #3a2317)" />
  </g>

  <text
    x="210"
    y="306"
    text-anchor="middle"
    fill="var(--cacau-700, #3a2317)"
    font-family="'Hepta Slab', Georgia, serif"
    font-size="54"
    font-weight="800"
    letter-spacing="0"
    textLength="282"
    lengthAdjust="spacingAndGlyphs"
  >
    MANDRAQUE
  </text>

  <text
    x="210"
    y="362"
    text-anchor="middle"
    fill="var(--cacau-700, #3a2317)"
    font-family="'Archivo', 'Segoe UI', sans-serif"
    font-size="15"
    font-weight="600"
    letter-spacing="4.5"
  >
    DESDE 2015
  </text>
</svg>
