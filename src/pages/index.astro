---
import BaseLayout from '../layouts/BaseLayout.astro';
import Emblem from '../components/Emblem.astro';
import { negocio, servicos, diferenciais, whatsappLink } from '../data/negocio.js';
import { url } from '../utils/url.js';
---

<BaseLayout title="Corte, barba e prosa em Canoas">
  <!-- ===== Hero ===== -->
  <section class="hero texture">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__local">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10" r="2.6" />
          </svg>
          Jardim das Acácias · Canoas
        </p>

        <h1>Corte, barba <br />e prosa.</h1>

        <p class="hero__lead">
          Desde 2015, a Mandraque é a barbearia de bairro de quem gosta de sair
          com o visual no ponto. Tesoura, navalha e uma conversa que faz a
          cadeira valer a pena.
        </p>

        <div class="hero__actions">
          <a class="btn" href={whatsappLink()} target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.52 3.48A11.8 11.8 0 0 0 12.05 0C5.5 0 .2 5.3.2 11.85c0 2.09.55 4.13 1.6 5.93L0 24l6.38-1.67a11.8 11.8 0 0 0 5.67 1.44h.01c6.55 0 11.85-5.3 11.85-11.85 0-3.17-1.23-6.15-3.39-8.44ZM12.06 21.8a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.79.99 1.01-3.7-.23-.38a9.8 9.8 0 0 1-1.5-5.23c0-5.43 4.42-9.85 9.87-9.85 2.63 0 5.1 1.03 6.96 2.89a9.78 9.78 0 0 1 2.88 6.96c0 5.44-4.43 9.86-9.84 9.9Zm5.4-7.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.34 5.1 4.68.71.31 1.27.49 1.7.63.72.23 1.37.2 1.89.12.58-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.19-.57-.34Z" />
            </svg>
            Agendar pelo WhatsApp
          </a>
          <a class="btn btn--outline" href="#servicos">Ver serviços e valores</a>
        </div>

        <dl class="hero__facts">
          <div>
            <dt>Desde 2015</dt>
            <dd>de porta aberta</dd>
          </div>
          <div>
            <dt>Barba, cabelo e bigode</dt>
            <dd>e corte infantil</dd>
          </div>
          <div>
            <dt>Hora marcada</dt>
            <dd>pelo WhatsApp</dd>
          </div>
        </dl>
      </div>

      <div class="hero__visual">
        <div class="hero__selo">
          <Emblem />
        </div>
        <p class="hero__legenda">
          Rua das Acácias, 512<br />
          Jardim das Acácias · Canoas
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Faixa de serviços ===== -->
  <div class="ticker">
    <p class="sr-only">Serviços: barba, cabelo, bigode e corte infantil.</p>
    <div class="ticker__track" aria-hidden="true">
      <div class="ticker__grupo">
        <span class="ticker__item">Barba</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Cabelo</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Bigode</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Corte infantil</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Desde 2015</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Jardim das Acácias</span>
        <span class="ticker__sep">✦</span>
      </div>
      <div class="ticker__grupo">
        <span class="ticker__item">Barba</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Cabelo</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Bigode</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Corte infantil</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Desde 2015</span>
        <span class="ticker__sep">✦</span>
        <span class="ticker__item">Jardim das Acácias</span>
        <span class="ticker__sep">✦</span>
      </div>
    </div>
  </div>

  <!-- ===== Serviços ===== -->
  <section class="section section--creme servicos" id="servicos">
    <div class="container">
      <div class="servicos__topo">
        <div class="section-head">
          <p class="rotulo">O menu da casa</p>
          <h2>O que sai da cadeira.</h2>
          <p>
            Cinco serviços, um combinado: sair daqui com o visual do jeito que
            você pediu. Escolha o seu e chame no WhatsApp para marcar.
          </p>
        </div>
        <p class="servicos__nota">
          Atendimento com hora marcada. A agenda é combinada no WhatsApp.
        </p>
      </div>

      <div class="servicos__lista">
        {servicos.map((servico) => (
          <a
            class="servico"
            href={whatsappLink(`Olá! Quero agendar ${servico.nome} na Mandraque.`)}
            target="_blank"
            rel="noopener"
          >
            <span class="servico__nome">{servico.nome}</span>
            <span class="servico__desc">{servico.descricao}</span>
            <span class="servico__meta">
              <span>{servico.duracao}</span>
              <strong>{servico.preco}</strong>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.52 3.48A11.8 11.8 0 0 0 12.05 0C5.5 0 .2 5.3.2 11.85c0 2.09.55 4.13 1.6 5.93L0 24l6.38-1.67a11.8 11.8 0 0 0 5.67 1.44h.01c6.55 0 11.85-5.3 11.85-11.85 0-3.17-1.23-6.15-3.39-8.44ZM12.06 21.8a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.79.99 1.01-3.7-.23-.38a9.8 9.8 0 0 1-1.5-5.23c0-5.43 4.42-9.85 9.87-9.85 2.63 0 5.1 1.03 6.96 2.89a9.78 9.78 0 0 1 2.88 6.96c0 5.44-4.43 9.86-9.84 9.9Zm5.4-7.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.34 5.1 4.68.71.31 1.27.49 1.7.63.72.23 1.37.2 1.89.12.58-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.19-.57-.34Z" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <div class="servicos__rodape">
        <p class="fine-print">
          Valores e tempos ilustrativos neste demo. Confirme o valor atual no
          WhatsApp antes de agendar.
        </p>
        <a class="link-simples" href={whatsappLink('Olá! Queria saber mais sobre os serviços da Mandraque.')} target="_blank" rel="noopener">
          Tirar uma dúvida
        </a>
      </div>
    </div>
  </section>

  <!-- ===== Espaço ===== -->
  <section class="section espaco" id="espaco">
    <div class="container espaco__grid">
      <div class="espaco__fotos">
        <figure class="foto foto--barba">
          <img
            src={url('/fotos/barba.jpg')}
            alt="Barbeiro fazendo o acabamento da barba de um cliente"
            width="900"
            height="1200"
            loading="lazy"
          />
          <figcaption>Barba na navalha</figcaption>
        </figure>
        <figure class="foto foto--salao">
          <img
            src={url('/fotos/salao.jpg')}
            alt="Salão com cadeiras de barbeiro e parede de tijolo"
            width="900"
            height="600"
            loading="lazy"
          />
          <figcaption>A casa</figcaption>
        </figure>
        <figure class="foto foto--corte">
          <img
            src={url('/fotos/corte.jpg')}
            alt="Barbeiro cortando o cabelo de um cliente com tesoura"
            width="900"
            height="1200"
            loading="lazy"
          />
          <figcaption>Acabamento no detalhe</figcaption>
        </figure>
      </div>

      <div class="espaco__copy">
        <p class="rotulo">Nosso espaço</p>
        <h2>Uma cadeira, um espelho e boa conversa.</h2>
        <p class="espaco__texto">
          A Mandraque é pequena do jeito certo: dá para ouvir a conversa, o
          barbeiro conhece o teu corte e ninguém tem pressa de te mandar embora.
        </p>
        <p class="espaco__texto">
          Você chega, senta e conta o que quer. A gente capricha no corte, cuida
          do acabamento e devolve você para a rua com o visual no ponto.
        </p>

        <p class="espaco__citacao">Corte caprichado não tem pressa.</p>

        <ul class="espaco__lista">
          <li>Atendimento com hora marcada</li>
          <li>Barba na navalha e toalha quente</li>
          <li>Corte infantil com paciência de sobra</li>
          <li>Produtos para levar e manter o visual</li>
        </ul>

        <p class="fine-print espaco__nota">
          Fotos de banco de imagens usadas apenas para ilustrar este demo.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== História ===== -->
  <section class="section historia texture" id="historia">
    <div class="container historia__grid">
      <div class="historia__ano">
        <span>desde</span>
        <strong>2015</strong>
        <p>Jardim das Acácias<br />Canoas · RS</p>
      </div>

      <div class="historia__copy">
        <p class="rotulo">A história</p>
        <h2>De bairro, com orgulho.</h2>
        <p class="historia__texto">
          Em 2015, a Mandraque abriu as portas no Jardim das Acácias com uma ideia
          simples: fazer barbearia de verdade, sem pressa e sem frescura. De lá
          para cá, a cadeira virou ponto de encontro de quem gosta de sair com o
          visual no ponto e de trocar uma ideia.
        </p>
        <p class="historia__texto">
          O que não muda é o capricho: tesoura afiada, navalha no ponto e
          atenção a cada detalhe. Do primeiro corte da criança ao bigode de quem
          tem história para contar.
        </p>

        <dl class="diferenciais">
          {diferenciais.map((item) => (
            <div>
              <dt>{item.titulo}</dt>
              <dd>{item.texto}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ===== Curso e produtos ===== -->
  <section class="section curso" id="curso">
    <div class="container">
      <div class="section-head">
        <p class="rotulo">Além da cadeira</p>
        <h2>Aprender e levar o cuidado para casa.</h2>
        <p>
          A Mandraque também ensina quem quer entrar na profissão e vende os
          produtos que usa aqui dentro. Tudo combinado direto com a gente.
        </p>
      </div>

      <div class="curso__dupla">
        <article class="bloco">
          <svg class="bloco__icone" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="6" cy="6" r="2.6" />
            <circle cx="6" cy="18" r="2.6" />
            <path d="M8.2 7.6 20 19M8.2 16.4 20 5" />
          </svg>
          <p class="bloco__tipo">Curso</p>
          <h3>Curso iniciante de barbearia</h3>
          <p>
            Para quem quer começar na profissão ou afiar o que já sabe. Prática
            na cadeira, com quem está no dia a dia da barbearia.
          </p>
          <a
            class="btn btn--outline"
            href={whatsappLink('Olá! Quero saber mais sobre o curso iniciante de barbearia.')}
            target="_blank"
            rel="noopener"
          >
            Falar sobre o curso
          </a>
        </article>

        <article class="bloco">
          <svg class="bloco__icone" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 3h6v3H9z" />
            <path d="M8 6h8l1 4v9a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1v-9z" />
            <path d="M7.5 12h9" />
          </svg>
          <p class="bloco__tipo">Produtos</p>
          <h3>Pomada, óleo e navalha</h3>
          <p>
            Os mesmos produtos que a gente usa na cadeira, para manter o visual
            em casa. Fale com a gente para ver o que tem disponível.
          </p>
          <a
            class="btn btn--outline"
            href={negocio.instagramUrl}
            target="_blank"
            rel="noopener"
          >
            Ver produtos no Instagram
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== Onde fica ===== -->
  <section class="section onde" id="onde">
    <div class="container onde__grid">
      <div class="onde__copy">
        <p class="rotulo">Onde fica</p>
        <h2>No Jardim das Acácias, pertinho de você.</h2>
        <p class="onde__texto">
          A barbearia fica em Canoas. Se vier de longe, chama no
          WhatsApp que a gente explica o caminho e combina o melhor horário.
        </p>

        <address class="onde__endereco">
          <strong>{negocio.endereco.rua}</strong><br />
          {negocio.endereco.bairro} · {negocio.endereco.cidade}/{negocio.endereco.uf}<br />
          CEP {negocio.endereco.cep}
        </address>

        <div class="onde__contatos">
          <a class="btn" href={whatsappLink()} target="_blank" rel="noopener">
            Agendar pelo WhatsApp
          </a>
          <a class="btn btn--outline" href={negocio.googleMapsUrl} target="_blank" rel="noopener">
            Abrir no Google Maps
          </a>
        </div>

        <div class="onde__horario">
          <h3>Horário</h3>
          <p>
            Atendimento com hora marcada. Consulte os horários da semana pelo
            WhatsApp — a agenda é combinada conforme a demanda.
          </p>
        </div>
      </div>

      <figure class="onde__foto">
        <img
          src={url('/fotos/fachada.jpg')}
          alt="Fachada ilustrativa de barbearia com letreiro de neon"
          width="900"
          height="900"
          loading="lazy"
        />
        <figcaption>
          <span>Fachada ilustrativa</span>
          <a href="https://www.pexels.com/photo/37318666/" target="_blank" rel="noopener">Foto: Pexels</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== CTA final ===== -->
  <section class="cta-final">
    <svg class="cta-final__poste" viewBox="0 0 140 320" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <rect x="20" y="20" width="100" height="280" rx="50" fill="currentColor" />
      <clipPath id="pole-cta">
        <rect x="20" y="20" width="100" height="280" rx="50" />
      </clipPath>
      <g clip-path="url(#pole-cta)" stroke="var(--creme)" stroke-width="18">
        <path d="M0 -40 L140 100" />
        <path d="M0 10 L140 150" />
        <path d="M0 60 L140 200" />
        <path d="M0 110 L140 250" />
        <path d="M0 160 L140 300" />
        <path d="M0 210 L140 350" />
        <path d="M0 260 L140 400" />
      </g>
      <rect x="10" y="0" width="120" height="28" rx="10" fill="currentColor" />
      <rect x="10" y="292" width="120" height="28" rx="10" fill="currentColor" />
    </svg>

    <div class="container cta-final__inner">
      <div>
        <p class="rotulo">Agenda aberta</p>
        <h2>Passa na cadeira.</h2>
        <p>
          Manda uma mensagem, escolhe o melhor horário e vem. A gente cuida do
          corte; a prosa fica por sua conta.
        </p>
      </div>
      <div class="cta-final__actions">
        <a class="btn btn--dark" href={whatsappLink()} target="_blank" rel="noopener">
          Agendar pelo WhatsApp
        </a>
        <a class="btn btn--dark" href={`tel:+${negocio.whatsapp}`}>{negocio.telefoneDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    overflow: hidden;
    background-color: var(--cacau);
    border-bottom: 1px solid var(--borda);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -18rem;
    right: -14rem;
    width: 52rem;
    height: 52rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(178, 122, 74, 0.2), transparent 64%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.06fr 0.94fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }

  .hero__local {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--bronze-claro);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .hero h1 {
    max-width: 11ch;
    font-size: clamp(3.2rem, 8.2vw, 6.6rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .hero__lead {
    max-width: 45ch;
    margin-top: 1.6rem;
    color: var(--texto-suave);
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, auto));
    gap: 1.25rem 2.25rem;
    margin-top: 2.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--borda);
  }

  .hero__facts div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero__facts dt {
    color: var(--creme);
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .hero__facts dd {
    margin: 0;
    color: var(--texto-suave);
    font-size: 0.78rem;
  }

  .hero__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-self: center;
  }

  .hero__selo {
    width: clamp(15rem, 27vw, 24rem);
    transform: rotate(-3deg);
    filter: drop-shadow(14px 16px 0 rgba(15, 7, 4, 0.3));
    animation: selo 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero__selo :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero__legenda {
    margin-top: 1.8rem;
    color: var(--texto-suave);
    font-size: 0.76rem;
    line-height: 1.6;
    text-align: center;
  }

  @keyframes selo {
    from {
      opacity: 0;
      transform: rotate(-9deg) scale(0.94);
    }
    to {
      opacity: 1;
      transform: rotate(-3deg) scale(1);
    }
  }

  /* ===== Faixa ===== */
  .ticker {
    overflow: hidden;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--cacau-900);
    background: var(--creme);
    color: var(--cacau-900);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 34s linear infinite;
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  .ticker__grupo {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 1.1rem;
    padding-right: 1.1rem;
    white-space: nowrap;
  }

  .ticker__item {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
  }

  .ticker__sep {
    color: var(--bronze);
    font-size: 0.85rem;
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* ===== Serviços ===== */
  .servicos__topo {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .servicos__topo .section-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .servicos__nota {
    flex: 0 0 auto;
    max-width: 17rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-left: 1rem;
    border-left: 1px solid rgba(58, 35, 23, 0.35);
    color: var(--cacau-600);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .servicos__lista {
    border-bottom: 1px solid rgba(58, 35, 23, 0.28);
  }

  .servico {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.45fr) auto;
    grid-template-areas: 'nome desc meta';
    align-items: center;
    gap: 1.5rem;
